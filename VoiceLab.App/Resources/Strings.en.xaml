  <sys:String x:Key="About.Title">About</sys:String>
  <sys:String x:Key="About.Version">Version</sys:String>
  <sys:String x:Key="About.Private">Private, offline DSP</sys:String>
  <sys:String x:Key="About.PrivateDescription">Conventional digital signal processing changes pitch and tone on this computer.</sys:String>
  <sys:String x:Key="About.NoCloud">No cloud upload</sys:String>
  <sys:String x:Key="About.NoTelemetry">No telemetry</sys:String>
  <sys:String x:Key="About.NoAi">No AI or cloning</sys:String>
  <sys:String x:Key="About.Storage">Recording is opt-in and saves processed output only. Presets and settings remain on this computer.</sys:String>
  <sys:String x:Key="About.Dependencies">Runtime dependencies</sys:String>
  <sys:String x:Key="About.DependenciesDescription">Microsoft .NET 8 and NAudio 2.2.1 are used at runtime. License notices are included with the project.</sys:String>
  <sys:String x:Key="About.Limitations">Known limitations</sys:String>
  <sys:String x:Key="About.LimitationsDescription">Large pitch changes can sound metallic. Tone depth changes timbre rather than identity. Hardware compatibility varies by system.</sys:String>
  <sys:String x:Key="About.Responsible">Responsible use</sys:String>
  <sys:String x:Key="About.ResponsibleDescription">Process only microphones and recordings you are authorized to use. Presets modify tone and pitch; they do not reproduce a specific person.</sys:String>

