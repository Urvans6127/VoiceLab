  <sys:String x:Key="About.Private">Özel, çevrimdışı DSP</sys:String>
  <sys:String x:Key="About.PrivateDescription">Geleneksel dijital sinyal işleme, bu bilgisayarda perdeyi ve tonu değiştirir.</sys:String>
