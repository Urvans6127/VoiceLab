<UserControl x:Class="VoiceLab.App.Views.PresetsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource Presets.Title}" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Text="{DynamicResource Presets.Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition MinWidth="245" Width="0.38*"/><ColumnDefinition Width="16"/><ColumnDefinition MinWidth="390" Width="0.62*"/></Grid.ColumnDefinitions>

      <ListBox ItemsSource="{Binding Workspace.Presets, Mode=OneWay}" SelectedItem="{Binding Workspace.SelectedPreset}" ItemContainerStyle="{StaticResource PresetItemStyle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Margin="10,0,0,0">
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                        <Setter Property="Text" Value="{DynamicResource Common.Custom}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn, Mode=OneWay}" Value="True"><Setter Property="Text" Value="{DynamicResource Common.BuiltIn}"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="0,0,0,22">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Presets.Selected}" Style="{StaticResource SectionTitleStyle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Workspace.SelectedPreset.Name, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Margin="10,0,0,0"><TextBlock Text="{Binding Workspace.PresetKind, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/></Border>
                </Grid>
                <TextBlock Text="{Binding Workspace.CustomStatus, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource FocusBorderBrush}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Presets.LivePreview}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Presets.LivePreviewDescription}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"/>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Top"><TextBlock Text="{Binding PreviewStatus, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
                </Grid>

                <Grid IsEnabled="{Binding CanSelectPreviewDevices, Mode=OneWay}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Devices.Microphone}" Style="{StaticResource MutedTextStyle}"/>
                    <ComboBox ItemsSource="{Binding Workspace.Inputs, Mode=OneWay}" SelectedItem="{Binding Workspace.SelectedInput}" DisplayMemberPath="DisplayName" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Presets.PreviewDevice}" Style="{StaticResource MutedTextStyle}"/>
                    <ComboBox ItemsSource="{Binding Workspace.PreviewOutputs, Mode=OneWay}" SelectedItem="{Binding Workspace.SelectedPreviewOutput}" DisplayMemberPath="DisplayName" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid><TextBlock Text="{DynamicResource Presets.InputLevel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Workspace.InputRms, StringFormat={}{0:F0}% RMS, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}"/></Grid>
                    <ProgressBar Value="{Binding Workspace.InputLevel, Mode=OneWay}" Maximum="100" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid><TextBlock Text="{DynamicResource Presets.ProcessedLevel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Workspace.OutputRms, StringFormat={}{0:F0}% RMS, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}"/></Grid>
                    <ProgressBar Value="{Binding Workspace.OutputLevel, Mode=OneWay}" Maximum="100" Margin="0,5,0,0"/>
                  </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource Presets.StartPreview}" Command="{Binding StartPreviewCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{DynamicResource Presets.StopPreview}" Command="{Binding StopPreviewCommand, Mode=OneWay}"/></WrapPanel>
                <TextBlock Text="{DynamicResource Presets.PreviewHeadphones}" Style="{StaticResource SecondaryTextStyle}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Presets.NameActions}" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="{DynamicResource Presets.Name}" Style="{StaticResource MutedTextStyle}"/>
                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                <WrapPanel><Button Content="{DynamicResource Presets.Duplicate}" Command="{Binding DuplicateCommand, Mode=OneWay}"/><Button Content="{DynamicResource Presets.SaveAs}" Command="{Binding SaveAsCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{DynamicResource Presets.Rename}" Command="{Binding RenameCommand, Mode=OneWay}"/><Button Content="{DynamicResource Presets.Delete}" Command="{Binding DeleteCommand, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Presets.ImportExport}" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="{DynamicResource Presets.ImportExportDescription}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"/>
                <WrapPanel><Button Content="{DynamicResource Presets.ImportJson}" Command="{Binding ImportCommand, Mode=OneWay}"/><Button Content="{DynamicResource Presets.ExportJson}" Command="{Binding ExportCommand, Mode=OneWay}"/></WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Presets.CustomDefaults}" Style="{StaticResource SectionTitleStyle}"/>
                <WrapPanel><Button Content="{DynamicResource Presets.SaveCustom}" Command="{Binding Workspace.SaveCustomCommand, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{DynamicResource Presets.ResetCustom}" Command="{Binding Workspace.ResetCustomCommand, Mode=OneWay}"/><Button Content="{DynamicResource Presets.RestoreBuiltIns}" Command="{Binding Workspace.RestoreCommand, Mode=OneWay}"/></WrapPanel>
                <TextBlock Text="{Binding Workspace.Error, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
