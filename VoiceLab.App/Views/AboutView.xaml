<UserControl x:Class="VoiceLab.App.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="0,0,0,22"><StackPanel MaxWidth="920">
    <TextBlock Text="{DynamicResource About.Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{DynamicResource App.Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20"><Run Text="{DynamicResource About.Version}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource About.Private}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource About.PrivateDescription}"/><WrapPanel Margin="0,12,0,0"><Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,8"><TextBlock Text="{DynamicResource About.NoCloud}" Foreground="{StaticResource SuccessBrush}"/></Border><Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,8"><TextBlock Text="{DynamicResource About.NoTelemetry}" Foreground="{StaticResource SuccessBrush}"/></Border><Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,8"><TextBlock Text="{DynamicResource About.NoAi}" Foreground="{StaticResource SuccessBrush}"/></Border></WrapPanel><TextBlock Text="{DynamicResource About.Storage}" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,8,14"><StackPanel><TextBlock Text="{DynamicResource About.Dependencies}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource About.DependenciesDescription}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,14"><StackPanel><TextBlock Text="{DynamicResource About.Limitations}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource About.LimitationsDescription}"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource About.Responsible}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource About.ResponsibleDescription}"/></StackPanel></Border>
  </StackPanel></Border></ScrollViewer>
</UserControl>
