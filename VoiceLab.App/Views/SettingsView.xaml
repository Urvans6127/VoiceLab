<UserControl x:Class="VoiceLab.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="0,0,0,22"><StackPanel MaxWidth="920">
    <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{DynamicResource Settings.Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20"/>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource Settings.LanguageDescription}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Languages, Mode=OneWay}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" HorizontalAlignment="Left" Width="220"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Settings.Recording}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{DynamicResource Settings.RecordingFolder}"/><TextBlock Text="{Binding RecordingFolder, Mode=OneWay}" ToolTip="{Binding RecordingFolder, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"/><Button Content="{DynamicResource Settings.ChooseFolder}" Command="{Binding ChooseRecordingFolderCommand, Mode=OneWay}" HorizontalAlignment="Left"/></StackPanel></Border>
  </StackPanel></Border></ScrollViewer>
</UserControl>
