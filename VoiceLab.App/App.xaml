<Application x:Class="VoiceLab.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:VoiceLab.App.ViewModels" xmlns:views="clr-namespace:VoiceLab.App.Views" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type vm:PresetsViewModel}"><views:PresetsView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:RecordingViewModel}"><views:RecordingView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
